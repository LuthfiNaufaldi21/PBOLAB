<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1200.0"
      prefHeight="720.0"
      styleClass="settings-page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- SIDEBAR -->
        <VBox minWidth="240.0"
              prefWidth="240.0"
              maxWidth="240.0"
              prefHeight="720.0"
              HBox.hgrow="NEVER"
              spacing="10.0"
              styleClass="sidebar">

            <padding>
                <Insets top="30.0"
                        right="24.0"
                        bottom="24.0"
                        left="24.0"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="12.0">

                    <children>

                        <Label text="C"
                               alignment="CENTER"
                               styleClass="sidebar-logo"/>

                        <VBox spacing="1.0">

                            <children>

                                <Label text="CrowdCare"
                                       styleClass="sidebar-title"/>

                                <Label text="Crowdfunding"
                                       styleClass="sidebar-subtitle"/>

                            </children>
                        </VBox>

                    </children>
                </HBox>

                <Region prefHeight="28.0"/>

                <Label text="MENU UTAMA"
                       styleClass="menu-caption"/>

                <Button text="Dashboard"
                        onAction="#openDashboard"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Campaign"
                        onAction="#openCampaigns"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Buat Campaign"
                        onAction="#openCreateCampaign"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Riwayat Donasi"
                        onAction="#openDonationHistory"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Region prefHeight="18.0"/>

                <Label text="AKUN"
                       styleClass="menu-caption"/>

                <Button text="Profil Saya"
                        onAction="#showProfile"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Pengaturan"
                        onAction="#showSettings"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button-active"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Separator styleClass="sidebar-separator"/>

                <Button text="Keluar"
                        onAction="#logout"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="logout-button"/>

            </children>
        </VBox>

        <!-- KONTEN UTAMA -->
        <VBox minWidth="0.0"
              prefHeight="720.0"
              HBox.hgrow="ALWAYS"
              styleClass="settings-page-main">

            <children>

                <!-- HEADER -->
                <HBox prefHeight="82.0"
                      alignment="CENTER_LEFT"
                      styleClass="dashboard-header">

                    <padding>
                        <Insets top="18.0"
                                right="30.0"
                                bottom="18.0"
                                left="30.0"/>
                    </padding>

                    <children>

                        <VBox spacing="3.0">

                            <children>

                                <Label text="Pengaturan"
                                       styleClass="dashboard-title"/>

                                <Label text="Atur preferensi, keamanan, dan notifikasi akun."
                                       styleClass="dashboard-subtitle"/>

                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Simpan Perubahan"
                                onAction="#handleSaveSettings"
                                prefHeight="40.0"
                                styleClass="settings-save-header-button"/>

                    </children>
                </HBox>

                <!-- AREA SCROLL -->
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            styleClass="dashboard-scroll">

                    <content>

                        <VBox spacing="22.0"
                              styleClass="settings-content">

                            <padding>
                                <Insets top="28.0"
                                        right="30.0"
                                        bottom="38.0"
                                        left="30.0"/>
                            </padding>

                            <children>

                                <!-- RINGKASAN AKUN -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="16.0"
                                      styleClass="settings-account-card">

                                    <children>

                                        <StackPane prefWidth="62.0"
                                                   prefHeight="62.0"
                                                   minWidth="62.0"
                                                   minHeight="62.0"
                                                   styleClass="settings-avatar">

                                            <children>

                                                <Label text="AR"
                                                       styleClass="settings-avatar-text"/>

                                            </children>
                                        </StackPane>

                                        <VBox spacing="4.0"
                                              HBox.hgrow="ALWAYS">

                                            <children>

                                                <Label text="Argha"
                                                       styleClass="settings-account-name"/>

                                                <Label text="argha@example.com"
                                                       styleClass="settings-account-email"/>

                                            </children>
                                        </VBox>

                                        <Label text="AKUN AKTIF"
                                               styleClass="settings-account-status"/>

                                    </children>
                                </HBox>

                                <!-- PREFERENSI DAN NOTIFIKASI -->
                                <HBox spacing="22.0"
                                      alignment="TOP_LEFT"
                                      fillHeight="false">

                                    <children>

                                        <!-- PREFERENSI -->
                                        <VBox minWidth="0.0"
                                              spacing="17.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="settings-card">

                                            <children>

                                                <VBox spacing="4.0">

                                                    <children>

                                                        <Label text="Preferensi Aplikasi"
                                                               styleClass="settings-section-title"/>

                                                        <Label text="Sesuaikan tampilan dan pengalaman aplikasi."
                                                               styleClass="settings-section-description"/>

                                                    </children>
                                                </VBox>

                                                <Separator/>

                                                <HBox alignment="CENTER_LEFT">

                                                    <children>

                                                        <VBox spacing="4.0"
                                                              HBox.hgrow="ALWAYS">

                                                            <children>

                                                                <Label text="Bahasa"
                                                                       styleClass="settings-item-title"/>

                                                                <Label text="Pilih bahasa yang digunakan aplikasi."
                                                                       styleClass="settings-item-description"/>

                                                            </children>
                                                        </VBox>

                                                        <ComboBox promptText="Bahasa Indonesia"
                                                                  prefWidth="190.0"
                                                                  prefHeight="42.0"
                                                                  styleClass="settings-combobox"/>

                                                    </children>
                                                </HBox>

                                                <Separator/>

                                                <HBox alignment="CENTER_LEFT">

                                                    <children>

                                                        <VBox spacing="4.0"
                                                              HBox.hgrow="ALWAYS">

                                                            <children>

                                                                <Label text="Tema Gelap"
                                                                       styleClass="settings-item-title"/>

                                                                <Label text="Gunakan tampilan gelap pada aplikasi."
                                                                       styleClass="settings-item-description"/>

                                                            </children>
                                                        </VBox>

                                                        <CheckBox text="Aktifkan"
                                                                  styleClass="settings-checkbox"/>

                                                    </children>
                                                </HBox>

                                                <Separator/>

                                                <HBox alignment="CENTER_LEFT">

                                                    <children>

                                                        <VBox spacing="4.0"
                                                              HBox.hgrow="ALWAYS">

                                                            <children>

                                                                <Label text="Animasi Tampilan"
                                                                       styleClass="settings-item-title"/>

                                                                <Label text="Aktifkan efek transisi dan animasi."
                                                                       styleClass="settings-item-description"/>

                                                            </children>
                                                        </VBox>

                                                        <CheckBox text="Aktif"
                                                                  selected="true"
                                                                  styleClass="settings-checkbox"/>

                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                        <!-- NOTIFIKASI -->
                                        <VBox minWidth="330.0"
                                              prefWidth="330.0"
                                              maxWidth="330.0"
                                              spacing="17.0"
                                              HBox.hgrow="NEVER"
                                              styleClass="settings-card">

                                            <children>

                                                <VBox spacing="4.0">

                                                    <children>

                                                        <Label text="Notifikasi"
                                                               styleClass="settings-section-title"/>

                                                        <Label text="Pilih informasi yang ingin diterima."
                                                               styleClass="settings-section-description"/>

                                                    </children>
                                                </VBox>

                                                <Separator/>

                                                <CheckBox text="Notifikasi campaign baru"
                                                          selected="true"
                                                          styleClass="settings-notification-check"/>

                                                <CheckBox text="Perkembangan campaign"
                                                          selected="true"
                                                          styleClass="settings-notification-check"/>

                                                <CheckBox text="Status donasi"
                                                          selected="true"
                                                          styleClass="settings-notification-check"/>

                                                <CheckBox text="Email promosi"
                                                          styleClass="settings-notification-check"/>

                                                <CheckBox text="Pengingat campaign"
                                                          selected="true"
                                                          styleClass="settings-notification-check"/>

                                                <VBox spacing="6.0"
                                                      styleClass="settings-info-box">

                                                    <children>

                                                        <Label text="Informasi"
                                                               styleClass="settings-info-title"/>

                                                        <Label text="Notifikasi penting mengenai keamanan akun akan tetap dikirim."
                                                               wrapText="true"
                                                               styleClass="settings-info-text"/>

                                                    </children>
                                                </VBox>

                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- KEAMANAN -->
                                <VBox spacing="18.0"
                                      styleClass="settings-card">

                                    <children>

                                        <VBox spacing="4.0">

                                            <children>

                                                <Label text="Keamanan Akun"
                                                       styleClass="settings-section-title"/>

                                                <Label text="Perbarui kata sandi untuk menjaga keamanan akun."
                                                       styleClass="settings-section-description"/>

                                            </children>
                                        </VBox>

                                        <Separator/>

                                        <HBox spacing="16.0">

                                            <children>

                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>

                                                        <Label text="Kata Sandi Saat Ini"
                                                               styleClass="settings-input-label"/>

                                                        <PasswordField promptText="Masukkan kata sandi saat ini"
                                                                       prefHeight="44.0"
                                                                       styleClass="settings-input"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>

                                                        <Label text="Kata Sandi Baru"
                                                               styleClass="settings-input-label"/>

                                                        <PasswordField promptText="Minimal 6 karakter"
                                                                       prefHeight="44.0"
                                                                       styleClass="settings-input"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>

                                                        <Label text="Konfirmasi Kata Sandi"
                                                               styleClass="settings-input-label"/>

                                                        <PasswordField promptText="Ulangi kata sandi baru"
                                                                       prefHeight="44.0"
                                                                       styleClass="settings-input"/>

                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_RIGHT">

                                            <children>

                                                <Button text="Ubah Kata Sandi"
                                                        onAction="#handleChangePassword"
                                                        prefHeight="42.0"
                                                        styleClass="settings-password-button"/>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                                <!-- PRIVASI DAN AKUN -->
                                <HBox spacing="22.0"
                                      alignment="TOP_LEFT"
                                      fillHeight="false">

                                    <children>

                                        <VBox minWidth="0.0"
                                              spacing="17.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="settings-card">

                                            <children>

                                                <Label text="Privasi"
                                                       styleClass="settings-section-title"/>

                                                <Separator/>

                                                <CheckBox text="Tampilkan nama pada daftar donatur"
                                                          selected="true"
                                                          styleClass="settings-notification-check"/>

                                                <CheckBox text="Izinkan pengguna melihat profil saya"
                                                          selected="true"
                                                          styleClass="settings-notification-check"/>

                                                <CheckBox text="Sembunyikan jumlah donasi"
                                                          styleClass="settings-notification-check"/>

                                            </children>
                                        </VBox>

                                        <VBox minWidth="330.0"
                                              prefWidth="330.0"
                                              maxWidth="330.0"
                                              spacing="14.0"
                                              HBox.hgrow="NEVER"
                                              styleClass="settings-danger-card">

                                            <children>

                                                <Label text="Zona Berbahaya"
                                                       styleClass="settings-danger-title"/>

                                                <Label text="Tindakan berikut tidak dapat dibatalkan setelah dikonfirmasi."
                                                       wrapText="true"
                                                       styleClass="settings-danger-description"/>

                                                <Separator/>

                                                <Button text="Hapus Akun"
                                                        onAction="#handleDeleteAccount"
                                                        prefWidth="280.0"
                                                        prefHeight="42.0"
                                                        styleClass="settings-delete-button"/>

                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- TOMBOL BAWAH -->
                                <HBox alignment="CENTER_RIGHT"
                                      spacing="12.0">

                                    <children>

                                        <Button text="Batalkan"
                                                onAction="#openDashboard"
                                                prefHeight="42.0"
                                                styleClass="settings-cancel-button"/>

                                        <Button text="Simpan Pengaturan"
                                                onAction="#handleSaveSettings"
                                                prefHeight="42.0"
                                                styleClass="settings-save-button"/>

                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>
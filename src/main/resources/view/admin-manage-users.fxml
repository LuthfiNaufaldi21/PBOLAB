<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1200.0"
      prefHeight="720.0"
      styleClass="admin-page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- Sidebar -->
        <VBox minWidth="240.0" prefWidth="240.0" maxWidth="240.0"
              prefHeight="720.0" HBox.hgrow="NEVER"
              spacing="10.0" styleClass="sidebar">
            <padding><Insets top="30.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="C" alignment="CENTER" styleClass="sidebar-logo"/>
                        <VBox spacing="1.0">
                            <children>
                                <Label text="CrowdCare" styleClass="sidebar-title"/>
                                <Label text="Admin Panel" styleClass="sidebar-subtitle"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region prefHeight="28.0"/>
                <Label text="ADMINISTRASI" styleClass="menu-caption"/>

                <Button text="Dashboard Admin" onAction="#openAdminDashboard"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Approval Campaign" onAction="#openAdminApproval"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Kelola Pengguna" onAction="#handleViewUsers"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Laporan Sistem" onAction="#handleViewReports"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Region prefHeight="18.0"/>
                <Label text="AKUN" styleClass="menu-caption"/>

                <Button text="Kelola Akun" onAction="#handleManageUsers"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button-active"/>

                <Region prefHeight="18.0"/>
                <Label text="SISTEM" styleClass="menu-caption"/>

                <Button text="Muat Ulang Data" onAction="#handleRefresh"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Pengaturan Admin" onAction="#handleAdminSettings"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator styleClass="sidebar-separator"/>

                <Button text="Keluar" onAction="#handleLogout"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="logout-button"/>

            </children>
        </VBox>

        <!-- Main Content -->
        <VBox minWidth="0.0" prefHeight="720.0" HBox.hgrow="ALWAYS" styleClass="admin-page-main">
            <children>

                <!-- Header -->
                <HBox prefHeight="82.0" alignment="CENTER_LEFT" styleClass="dashboard-header">
                    <padding><Insets top="18.0" right="30.0" bottom="18.0" left="30.0"/></padding>
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Kelola Akun" styleClass="dashboard-title"/>
                                <Label text="Lihat dan hapus akun penggalang dana serta donatur."
                                       styleClass="dashboard-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <children>
                                <Label text="Administrator" styleClass="profile-name"/>
                                <Label text="Super Admin" styleClass="profile-role"/>
                            </children>
                        </VBox>
                        <StackPane prefWidth="44.0" prefHeight="44.0" styleClass="admin-avatar">
                            <children>
                                <Label text="AD" styleClass="admin-avatar-text"/>
                            </children>
                        </StackPane>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            styleClass="dashboard-scroll">
                    <content>
                        <VBox spacing="22.0" styleClass="admin-content">
                            <padding><Insets top="28.0" right="30.0" bottom="38.0" left="30.0"/></padding>
                            <children>

                                <!-- Stat row -->
                                <HBox spacing="16.0">
                                    <children>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Total Akun" styleClass="admin-stat-label"/>
                                                <Label fx:id="manageTotalUsers" text="..." styleClass="admin-stat-value"/>
                                                <Label text="donatur + penggalang" styleClass="admin-stat-description"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Donatur" styleClass="admin-stat-label"/>
                                                <Label fx:id="manageDonorCount" text="..." styleClass="admin-stat-value"/>
                                                <Label text="pengguna aktif berdonasi" styleClass="admin-stat-positive"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Penggalang Dana" styleClass="admin-stat-label"/>
                                                <Label fx:id="manageFundraiserCount" text="..." styleClass="admin-stat-value"/>
                                                <Label text="pembuat campaign" styleClass="admin-stat-description"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Table -->
                                <VBox styleClass="admin-approval-section" spacing="0.0">
                                    <children>

                                        <!-- Table Header -->
                                        <HBox styleClass="user-table-header" alignment="CENTER_LEFT" spacing="0.0">
                                            <padding><Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/></padding>
                                            <children>
                                                <Label text="PENGGUNA" styleClass="user-table-header-label"
                                                       prefWidth="240.0"/>
                                                <Label text="KONTAK" styleClass="user-table-header-label"
                                                       prefWidth="200.0"/>
                                                <Label text="ROLE" styleClass="user-table-header-label"
                                                       prefWidth="130.0"/>
                                                <Label text="TERDAFTAR" styleClass="user-table-header-label"
                                                       prefWidth="150.0"/>
                                                <Label text="AKSI" styleClass="user-table-header-label"
                                                       HBox.hgrow="ALWAYS"/>
                                            </children>
                                        </HBox>

                                        <!-- Dynamic user list -->
                                        <VBox fx:id="manageUserListContainer" spacing="0.0">
                                            <children>
                                                <Label text="Memuat data pengguna..."
                                                       styleClass="admin-campaign-meta">
                                                    <padding><Insets top="16.0" left="16.0"/></padding>
                                                </Label>
                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>

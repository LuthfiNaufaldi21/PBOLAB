<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1200.0"
      prefHeight="720.0"
      styleClass="admin-page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <VBox minWidth="240.0" prefWidth="240.0" maxWidth="240.0"
              prefHeight="720.0" HBox.hgrow="NEVER"
              spacing="10.0" styleClass="sidebar">
            <padding><Insets top="30.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="C" alignment="CENTER" styleClass="sidebar-logo"/>
                        <VBox spacing="1.0">
                            <children>
                                <Label text="CrowdCare" styleClass="sidebar-title"/>
                                <Label text="Admin Panel" styleClass="sidebar-subtitle"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region prefHeight="28.0"/>
                <Label text="ADMINISTRASI" styleClass="menu-caption"/>

                <Button text="Dashboard Admin" onAction="#openAdminDashboard"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Approval Campaign" onAction="#openAdminApproval"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Kelola Pengguna" onAction="#handleViewUsers"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Laporan Sistem" onAction="#handleViewReports"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Region prefHeight="18.0"/>
                <Label text="SISTEM" styleClass="menu-caption"/>

                <Button text="Muat Ulang Data" onAction="#handleRefresh"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Pengaturan Admin" onAction="#handleAdminSettings"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button-active"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator styleClass="sidebar-separator"/>

                <Button text="Keluar" onAction="#handleLogout"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="logout-button"/>

            </children>
        </VBox>

        <VBox minWidth="0.0" prefHeight="720.0"
              HBox.hgrow="ALWAYS" styleClass="admin-page-main">

            <children>

                <HBox prefHeight="82.0" alignment="CENTER_LEFT"
                      styleClass="dashboard-header">
                    <padding><Insets top="18.0" right="30.0" bottom="18.0" left="30.0"/></padding>
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Pengaturan Admin" styleClass="dashboard-title"/>
                                <Label text="Konfigurasi sistem dan informasi akun administrator."
                                       styleClass="dashboard-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            styleClass="dashboard-scroll">
                    <content>
                        <VBox spacing="22.0" styleClass="admin-content">
                            <padding><Insets top="28.0" right="30.0" bottom="38.0" left="30.0"/></padding>
                            <children>

                                <VBox spacing="16.0" styleClass="admin-card">
                                    <children>
                                        <Label text="Informasi Akun" styleClass="admin-section-title"/>
                                        <Separator/>
                                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                                            <children>
                                                <VBox alignment="CENTER" spacing="10.0">
                                                    <children>
                                                        <StackPane prefWidth="72.0" prefHeight="72.0"
                                                                   minWidth="72.0" minHeight="72.0"
                                                                   styleClass="admin-avatar">
                                                            <children>
                                                                <ImageView fx:id="adminAvatarImage" fitWidth="72.0"
                                                                           fitHeight="72.0" preserveRatio="true"
                                                                           visible="false" managed="false"/>
                                                                <Label fx:id="adminSettingsAvatar" text="A"
                                                                       styleClass="admin-avatar-text"/>
                                                            </children>
                                                        </StackPane>
                                                        <Button text="Ubah Foto" onAction="#handleAdminChangePhoto"
                                                                prefHeight="30.0" maxWidth="100.0"
                                                                styleClass="admin-photo-button"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label fx:id="adminSettingsName" text="Administrator"
                                                               styleClass="admin-account-name"/>
                                                        <Label fx:id="adminSettingsRole" text="Admin"
                                                               styleClass="admin-account-role"/>
                                                    </children>
                                                </VBox>
                                                <Label text="AKTIF" styleClass="admin-status-badge"/>
                                            </children>
                                        </HBox>

                                        <Separator/>

                                        <HBox spacing="16.0">
                                            <children>
                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Nama Lengkap" styleClass="admin-input-label"/>
                                                        <TextField fx:id="adminNameField" prefHeight="40.0"
                                                                   styleClass="admin-input"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Email" styleClass="admin-input-label"/>
                                                        <TextField fx:id="adminEmailField" prefHeight="40.0"
                                                                   styleClass="admin-input"/>
                                                    </children>
                                                </VBox>
                                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Telepon" styleClass="admin-input-label"/>
                                                        <TextField fx:id="adminPhoneField" prefHeight="40.0"
                                                                   styleClass="admin-input"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox alignment="CENTER_RIGHT">
                                            <children>
                                                <Button text="Simpan Perubahan" onAction="#handleAdminSaveProfile"
                                                        prefHeight="40.0" styleClass="admin-save-button"/>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="16.0" styleClass="admin-card">
                                    <children>
                                        <Label text="Tentang Sistem" styleClass="admin-section-title"/>
                                        <Separator/>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label text="CrowdCare adalah aplikasi crowdfunding berbasis JavaFX dan Spring Boot."
                                                       wrapText="true" styleClass="admin-info-text"/>
                                                <Label text="Data tersimpan di database H2 in-memory yang di-reset setiap kali aplikasi dijalankan ulang."
                                                       wrapText="true" styleClass="admin-info-text"/>
                                                <Label text="Gunakan tombol 'Muat Ulang Data' di sidebar untuk menyegarkan data tanpa memuat ulang halaman."
                                                       wrapText="true" styleClass="admin-info-text"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <HBox spacing="16.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button text="Muat Ulang Data" onAction="#handleRefresh"
                                                prefHeight="42.0" styleClass="admin-refresh-button"/>
                                        <Button text="Kembali ke Dashboard" onAction="#openAdminDashboard"
                                                prefHeight="42.0" styleClass="admin-back-button"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>

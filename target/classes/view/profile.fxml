<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1200.0"
      prefHeight="720.0"
      styleClass="profile-page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- SIDEBAR -->
        <VBox minWidth="240.0"
              prefWidth="240.0"
              maxWidth="240.0"
              prefHeight="720.0"
              HBox.hgrow="NEVER"
              spacing="10.0"
              styleClass="sidebar">

            <padding>
                <Insets top="30.0"
                        right="24.0"
                        bottom="24.0"
                        left="24.0"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="12.0">

                    <children>

                        <Label text="C"
                               alignment="CENTER"
                               styleClass="sidebar-logo"/>

                        <VBox spacing="1.0">

                            <children>

                                <Label text="CrowdCare"
                                       styleClass="sidebar-title"/>

                                <Label text="Crowdfunding"
                                       styleClass="sidebar-subtitle"/>

                            </children>
                        </VBox>

                    </children>
                </HBox>

                <Region prefHeight="28.0"/>

                <Label text="MENU UTAMA"
                       styleClass="menu-caption"/>

                <Button text="Dashboard"
                        onAction="#openDashboard"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Campaign"
                        onAction="#openCampaigns"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button fx:id="btnCreateCampaign" text="Buat Campaign"
                        onAction="#openCreateCampaign"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button fx:id="btnDonationHistory" text="Riwayat Donasi"
                        onAction="#openDonationHistory"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Region prefHeight="18.0"/>

                <Label text="AKUN"
                       styleClass="menu-caption"/>

                <Button text="Profil Saya"
                        onAction="#showProfile"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button-active"/>

                <Button text="Pengaturan"
                        onAction="#showSettings"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Separator styleClass="sidebar-separator"/>

                <Button text="Keluar"
                        onAction="#logout"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="logout-button"/>

            </children>
        </VBox>

        <!-- KONTEN -->
        <VBox minWidth="0.0"
              prefHeight="720.0"
              HBox.hgrow="ALWAYS"
              styleClass="profile-page-main">

            <children>

                <!-- HEADER -->
                <HBox prefHeight="82.0"
                      alignment="CENTER_LEFT"
                      styleClass="dashboard-header">

                    <padding>
                        <Insets top="18.0"
                                right="30.0"
                                bottom="18.0"
                                left="30.0"/>
                    </padding>

                    <children>

                        <VBox spacing="3.0">

                            <children>

                                <Label text="Profil Saya"
                                       styleClass="dashboard-title"/>

                                <Label text="Kelola informasi dan identitas akun CrowdCare."
                                       styleClass="dashboard-subtitle"/>

                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="profileRoleBadgeLabel" text="DONATUR"
                               styleClass="profile-role-badge"/>

                    </children>
                </HBox>

                <!-- SCROLL -->
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            styleClass="dashboard-scroll">

                    <content>

                        <VBox spacing="22.0"
                              styleClass="profile-content">

                            <padding>
                                <Insets top="28.0"
                                        right="30.0"
                                        bottom="38.0"
                                        left="30.0"/>
                            </padding>

                            <children>

                                <!-- PROFILE OVERVIEW -->
                                <HBox alignment="CENTER_LEFT"
                                      spacing="24.0"
                                      styleClass="profile-overview-card">

                                    <children>

                                        <VBox alignment="CENTER" spacing="10.0">
                                            <children>
                                                <StackPane prefWidth="100.0"
                                                           prefHeight="100.0"
                                                           minWidth="100.0"
                                                           minHeight="100.0"
                                                           styleClass="profile-large-avatar">

                                                    <children>
                                                        <ImageView fx:id="profileAvatarImage" fitWidth="100.0"
                                                                   fitHeight="100.0" preserveRatio="true"
                                                                   visible="false" managed="false"
                                                                   styleClass="profile-avatar-image"/>
                                                        <Label fx:id="profileAvatarText" text="AR"
                                                               styleClass="profile-large-avatar-text"/>
                                                    </children>
                                                </StackPane>

                                                <Button text="Ubah Foto"
                                                        onAction="#handleChangePhoto"
                                                        prefHeight="34.0" maxWidth="140.0"
                                                        styleClass="profile-photo-button"/>
                                            </children>
                                        </VBox>

                                        <VBox spacing="7.0"
                                              HBox.hgrow="ALWAYS">

                                            <children>

                                                <Label fx:id="profileDisplayName" text="Argha"
                                                       styleClass="profile-display-name"/>

                                                <Label fx:id="profileDisplayEmail" text="argha@example.com"
                                                       styleClass="profile-display-email"/>

                                                <HBox spacing="8.0">

                                                    <children>

                                                        <Label text="Akun Terverifikasi"
                                                               styleClass="profile-verified-badge"/>

                                                        <Label text="Bergabung Juni 2026"
                                                               styleClass="profile-joined-badge"/>

                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- STATISTIK -->
                                <HBox spacing="16.0">

                                    <children>

                                        <VBox spacing="7.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="profile-stat-card">

                                            <children>

                                                <Label text="Total Donasi"
                                                       styleClass="profile-stat-label"/>

                                                <Label fx:id="profileTotalDonasi" text="Rp2.450.000"
                                                       styleClass="profile-stat-value"/>

                                                <Label fx:id="profileTotalTransaksi" text="8 transaksi"
                                                       styleClass="profile-stat-description"/>

                                            </children>
                                        </VBox>

                                        <VBox spacing="7.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="profile-stat-card">

                                            <children>

                                                <Label text="Campaign Didukung"
                                                       styleClass="profile-stat-label"/>

                                                <Label fx:id="profileCampaignSupported" text="6"
                                                       styleClass="profile-stat-value"/>

                                                <Label fx:id="profileCampaignSelesai" text="2 campaign selesai"
                                                       styleClass="profile-stat-description"/>

                                            </children>
                                        </VBox>

                                        <VBox spacing="7.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="profile-stat-card">

                                            <children>

                                                <Label text="Campaign Dibuat"
                                                       styleClass="profile-stat-label"/>

                                                <Label fx:id="profileCampaignDibuat" text="2"
                                                       styleClass="profile-stat-value"/>

                                                <Label fx:id="profileCampaignAktif" text="1 campaign aktif"
                                                       styleClass="profile-stat-description"/>

                                            </children>
                                        </VBox>

                                        <VBox spacing="7.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="profile-stat-card">

                                            <children>

                                                <Label text="Dampak Sosial"
                                                       styleClass="profile-stat-label"/>

                                                <Label fx:id="profileDampakSosial" text="156"
                                                       styleClass="profile-stat-value"/>

                                                <Label fx:id="profileOrangTerbantu" text="orang terbantu"
                                                       styleClass="profile-stat-description"/>

                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- FORM DAN INFORMASI AKUN -->
                                <HBox spacing="22.0"
                                      alignment="TOP_LEFT"
                                      fillHeight="false">

                                    <children>

                                        <!-- EDIT PROFIL -->
                                        <VBox minWidth="0.0"
                                              spacing="18.0"
                                              HBox.hgrow="ALWAYS"
                                              styleClass="profile-form-card">

                                            <children>

                                                <VBox spacing="4.0">

                                                    <children>

                                                        <Label text="Informasi Pribadi"
                                                               styleClass="profile-section-title"/>

                                                        <Label text="Perbarui informasi dasar akun Anda."
                                                               styleClass="profile-section-description"/>

                                                    </children>
                                                </VBox>

                                                <Separator/>

                                                <HBox spacing="16.0">

                                                    <children>

                                                        <VBox spacing="8.0"
                                                              HBox.hgrow="ALWAYS">

                                                            <children>

                                                                <Label text="Nama Lengkap"
                                                                       styleClass="profile-input-label"/>

                                                                <TextField fx:id="profileNameField" text="Argha"
                                                                            prefHeight="44.0"
                                                                            styleClass="profile-input"/>

                                                            </children>
                                                        </VBox>

                                                        <VBox spacing="8.0"
                                                              HBox.hgrow="ALWAYS">

                                                            <children>

                                                                <Label text="Nomor Telepon"
                                                                       styleClass="profile-input-label"/>

                                                                <TextField fx:id="profilePhoneField" text="081234567890"
                                                                            prefHeight="44.0"
                                                                            styleClass="profile-input"/>

                                                            </children>
                                                        </VBox>

                                                    </children>
                                                </HBox>

                                                <VBox spacing="8.0">

                                                    <children>

                                                        <Label text="Email"
                                                               styleClass="profile-input-label"/>

                                                        <TextField fx:id="profileEmailField" text="argha@example.com"
                                                                    prefHeight="44.0"
                                                                    styleClass="profile-input"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0">

                                                    <children>

                                                        <Label text="Alamat"
                                                               styleClass="profile-input-label"/>

                                                        <TextField fx:id="profileAddressField" text="Medan, Sumatera Utara"
                                                                    prefHeight="44.0"
                                                                    styleClass="profile-input"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0">

                                                    <children>

                                                        <Label text="Tentang Saya"
                                                               styleClass="profile-input-label"/>

                                                        <TextArea fx:id="profileBioArea" text="Saya ingin membantu campaign yang memberikan dampak positif bagi masyarakat."
                                                                   prefHeight="110.0"
                                                                   wrapText="true"
                                                                   styleClass="profile-textarea"/>

                                                    </children>
                                                </VBox>

                                                <HBox alignment="CENTER_RIGHT">

                                                    <children>

                                                        <Button text="Simpan Perubahan"
                                                                onAction="#handleSaveProfile"
                                                                prefHeight="42.0"
                                                                styleClass="profile-save-button"/>

                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                        <!-- INFORMASI AKUN -->
                                        <VBox minWidth="300.0"
                                              prefWidth="300.0"
                                              maxWidth="300.0"
                                              spacing="16.0"
                                              HBox.hgrow="NEVER"
                                              styleClass="profile-info-card">

                                            <children>

                                                <Label text="Informasi Akun"
                                                       styleClass="profile-section-title"/>

                                                <Separator/>

                                                <HBox alignment="CENTER_LEFT">

                                                    <children>

                                                        <VBox spacing="4.0">

                                                            <children>

                                                                <Label text="Jenis Akun"
                                                                       styleClass="profile-info-caption"/>

                                                                <Label fx:id="profileInfoRoleLabel" text="Donatur"
                                                                       styleClass="profile-info-value"/>

                                                            </children>
                                                        </VBox>

                                                        <Region HBox.hgrow="ALWAYS"/>

                                                        <Label text="AKTIF"
                                                               styleClass="profile-active-label"/>

                                                    </children>
                                                </HBox>

                                                <VBox spacing="4.0">

                                                    <children>

                                                                <Label text="ID Pengguna"
                                                                       styleClass="profile-info-caption"/>

                                                                <Label fx:id="profileInfoIdLabel" text="USR-2026-00128"
                                                                       styleClass="profile-info-value"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="4.0">

                                                    <children>

                                                        <Label text="Tanggal Bergabung"
                                                               styleClass="profile-info-caption"/>

                                                        <Label fx:id="profileInfoJoinLabel" text="1 Juni 2026"
                                                               styleClass="profile-info-value"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="4.0">

                                                    <children>

                                                        <Label text="Terakhir Masuk"
                                                               styleClass="profile-info-caption"/>

                                                        <Label fx:id="profileInfoLoginLabel" text="Hari ini, 20.15 WIB"
                                                               styleClass="profile-info-value"/>

                                                    </children>
                                                </VBox>

                                                <Separator/>

                                                <VBox spacing="8.0"
                                                      styleClass="profile-tip-box">

                                                    <children>

                                                        <Label text="Lengkapi Profil"
                                                               styleClass="profile-tip-title"/>

                                                        <Label text="Profil yang lengkap membantu meningkatkan kepercayaan pengguna lain."
                                                               wrapText="true"
                                                               styleClass="profile-tip-text"/>

                                                    </children>
                                                </VBox>

                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>
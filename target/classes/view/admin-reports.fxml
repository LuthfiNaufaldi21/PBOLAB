<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1200.0"
      prefHeight="720.0"
      styleClass="admin-page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- Sidebar -->
        <VBox minWidth="240.0" prefWidth="240.0" maxWidth="240.0"
              prefHeight="720.0" HBox.hgrow="NEVER"
              spacing="10.0" styleClass="sidebar">
            <padding><Insets top="30.0" right="24.0" bottom="24.0" left="24.0"/></padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="C" alignment="CENTER" styleClass="sidebar-logo"/>
                        <VBox spacing="1.0">
                            <children>
                                <Label text="CrowdCare" styleClass="sidebar-title"/>
                                <Label text="Admin Panel" styleClass="sidebar-subtitle"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region prefHeight="28.0"/>
                <Label text="ADMINISTRASI" styleClass="menu-caption"/>

                <Button text="Dashboard Admin" onAction="#openAdminDashboard"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Approval Campaign" onAction="#openAdminApproval"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Kelola Pengguna" onAction="#handleViewUsers"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Laporan Sistem" onAction="#handleViewReports"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button-active"/>

                <Region prefHeight="18.0"/>
                <Label text="SISTEM" styleClass="menu-caption"/>

                <Button text="Muat Ulang Data" onAction="#handleRefresh"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Button text="Pengaturan Admin" onAction="#handleAdminSettings"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>
                <Separator styleClass="sidebar-separator"/>

                <Button text="Keluar" onAction="#handleLogout"
                        prefWidth="192.0" prefHeight="44.0"
                        alignment="CENTER_LEFT" styleClass="logout-button"/>

            </children>
        </VBox>

        <!-- Main Content -->
        <VBox minWidth="0.0" prefHeight="720.0" HBox.hgrow="ALWAYS" styleClass="admin-page-main">
            <children>

                <!-- Header -->
                <HBox prefHeight="82.0" alignment="CENTER_LEFT" styleClass="dashboard-header">
                    <padding><Insets top="18.0" right="30.0" bottom="18.0" left="30.0"/></padding>
                    <children>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="Laporan Sistem" styleClass="dashboard-title"/>
                                <Label text="Ringkasan data dan statistik platform CrowdCare."
                                       styleClass="dashboard-subtitle"/>
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <children>
                                <Label text="Administrator" styleClass="profile-name"/>
                                <Label text="Super Admin" styleClass="profile-role"/>
                            </children>
                        </VBox>
                        <StackPane prefWidth="44.0" prefHeight="44.0" styleClass="admin-avatar">
                            <children>
                                <Label text="AD" styleClass="admin-avatar-text"/>
                            </children>
                        </StackPane>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                            styleClass="dashboard-scroll">
                    <content>
                        <VBox spacing="22.0" styleClass="admin-content">
                            <padding><Insets top="28.0" right="30.0" bottom="38.0" left="30.0"/></padding>
                            <children>

                                <!-- Highlight cards -->
                                <HBox spacing="16.0">
                                    <children>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Total Pengguna" styleClass="admin-stat-label"/>
                                                <Label fx:id="reportTotalUsers" text="..." styleClass="admin-stat-value"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Total Campaign" styleClass="admin-stat-label"/>
                                                <Label fx:id="reportTotalCampaigns" text="..." styleClass="admin-stat-value"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Total Dana Terkumpul" styleClass="admin-stat-label"/>
                                                <Label fx:id="reportTotalDonation" text="..." styleClass="admin-stat-value"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="8.0" HBox.hgrow="ALWAYS" styleClass="admin-stat-card">
                                            <children>
                                                <Label text="Total Transaksi Donasi" styleClass="admin-stat-label"/>
                                                <Label fx:id="reportTotalTransaksi" text="..." styleClass="admin-stat-value"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Campaign breakdown + User breakdown side by side -->
                                <HBox spacing="20.0">
                                    <children>

                                        <!-- Campaign status breakdown -->
                                        <VBox spacing="18.0" HBox.hgrow="ALWAYS" styleClass="admin-approval-section">
                                            <children>
                                                <Label text="Status Campaign" styleClass="admin-section-title"/>
                                                <Separator/>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Disetujui" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barApproved" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblApproved" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Menunggu" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barPending" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblPending" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Ditolak" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barRejected" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblRejected" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Selesai" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barCompleted" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblCompleted" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                        <!-- User role breakdown -->
                                        <VBox spacing="18.0" HBox.hgrow="ALWAYS" styleClass="admin-approval-section">
                                            <children>
                                                <Label text="Komposisi Pengguna" styleClass="admin-section-title"/>
                                                <Separator/>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Admin" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barAdmin" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblAdminCount" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Donatur" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barDonor" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblDonorCount" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <Label text="Penggalang Dana" styleClass="report-bar-label"/>
                                                        <ProgressBar fx:id="barFundraiser" progress="0.0"
                                                                     prefWidth="200.0" prefHeight="12.0"
                                                                     styleClass="admin-system-progress"/>
                                                        <Label fx:id="lblFundraiserCount" text="0"
                                                               styleClass="report-bar-value"/>
                                                    </children>
                                                </HBox>

                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                                <!-- Dana per campaign -->
                                <VBox spacing="16.0" styleClass="admin-approval-section">
                                    <children>
                                        <Label text="Dana Terkumpul per Campaign" styleClass="admin-section-title"/>
                                        <Separator/>
                                        <VBox fx:id="campaignDanaList" spacing="10.0">
                                            <children>
                                                <Label text="Memuat data..." styleClass="admin-campaign-meta"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>

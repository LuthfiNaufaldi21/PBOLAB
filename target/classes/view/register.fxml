<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1000.0"
      prefHeight="650.0"
      styleClass="page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- PANEL KIRI -->
        <VBox minWidth="450.0"
              prefWidth="450.0"
              maxWidth="450.0"
              prefHeight="650.0"
              alignment="CENTER_LEFT"
              spacing="18.0"
              styleClass="brand-panel">

            <padding>
                <Insets top="55.0"
                        right="60.0"
                        bottom="45.0"
                        left="60.0"/>
            </padding>

            <children>

                <Label text="C"
                       alignment="CENTER"
                       styleClass="brand-logo"/>

                <Label text="CrowdCare"
                       styleClass="brand-title"/>

                <Label text="Mulai langkah kecil untuk memberikan perubahan besar."
                       wrapText="true"
                       prefWidth="320.0"
                       styleClass="brand-description"/>

                <Region prefHeight="25.0"/>

                <VBox spacing="16.0"
                      styleClass="register-benefit-box">

                    <children>

                        <HBox spacing="12.0"
                              alignment="CENTER_LEFT">

                            <children>

                                <Label text="✓"
                                       styleClass="benefit-icon"/>

                                <VBox spacing="3.0">

                                    <children>

                                        <Label text="Temukan campaign"
                                               styleClass="benefit-title"/>

                                        <Label text="Bantu berbagai campaign yang membutuhkan."
                                               wrapText="true"
                                               styleClass="benefit-description"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <HBox spacing="12.0"
                              alignment="CENTER_LEFT">

                            <children>

                                <Label text="✓"
                                       styleClass="benefit-icon"/>

                                <VBox spacing="3.0">

                                    <children>

                                        <Label text="Buat penggalangan dana"
                                               styleClass="benefit-title"/>

                                        <Label text="Ajukan campaign untuk membantu sesama."
                                               wrapText="true"
                                               styleClass="benefit-description"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <HBox spacing="12.0"
                              alignment="CENTER_LEFT">

                            <children>

                                <Label text="✓"
                                       styleClass="benefit-icon"/>

                                <VBox spacing="3.0">

                                    <children>

                                        <Label text="Pantau perkembangan"
                                               styleClass="benefit-title"/>

                                        <Label text="Lihat riwayat dan perkembangan donasi."
                                               wrapText="true"
                                               styleClass="benefit-description"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Label text="Bersama membantu, bersama memberi harapan."
                       wrapText="true"
                       styleClass="brand-footer"/>

            </children>
        </VBox>

        <!-- PANEL KANAN -->
        <StackPane prefWidth="550.0"
                   prefHeight="650.0"
                   HBox.hgrow="ALWAYS"
                   styleClass="register-form-panel">

            <children>

                <VBox maxWidth="420.0"
                      prefWidth="420.0"
                      alignment="CENTER_LEFT"
                      spacing="10.0"
                      styleClass="register-card">

                    <padding>
                        <Insets top="30.0"
                                right="38.0"
                                bottom="30.0"
                                left="38.0"/>
                    </padding>

                    <children>

                        <Label text="Buat Akun Baru"
                               styleClass="register-title"/>

                        <Label text="Daftar untuk mulai menggunakan CrowdCare"
                               styleClass="register-subtitle"/>

                        <Region prefHeight="5.0"/>

                        <Label text="Nama Lengkap"
                               styleClass="input-label"/>

                        <TextField fx:id="nameField"
                                   promptText="Masukkan nama lengkap"
                                   prefHeight="42.0"
                                   maxWidth="344.0"
                                   styleClass="form-input"/>

                        <Label text="Email"
                               styleClass="input-label"/>

                        <TextField fx:id="emailField"
                                   promptText="Masukkan email"
                                   prefHeight="42.0"
                                   maxWidth="344.0"
                                   styleClass="form-input"/>

                        <Label text="Jenis Akun"
                               styleClass="input-label"/>

                        <ComboBox fx:id="roleComboBox"
                                  promptText="Pilih jenis akun"
                                  prefHeight="42.0"
                                  maxWidth="344.0"
                                  styleClass="register-combobox"/>

                        <HBox spacing="12.0">

                            <children>

                                <VBox spacing="7.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Kata Sandi"
                                               styleClass="input-label"/>

                                        <PasswordField fx:id="passwordField"
                                                       promptText="Kata sandi"
                                                       prefHeight="42.0"
                                                       styleClass="form-input"/>

                                    </children>
                                </VBox>

                                <VBox spacing="7.0"
                                      HBox.hgrow="ALWAYS">

                                    <children>

                                        <Label text="Konfirmasi"
                                               styleClass="input-label"/>

                                        <PasswordField fx:id="confirmPasswordField"
                                                       promptText="Ulangi sandi"
                                                       prefHeight="42.0"
                                                       styleClass="form-input"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <CheckBox fx:id="termsCheckBox"
                                  text="Saya menyetujui syarat dan ketentuan CrowdCare"
                                  wrapText="true"
                                  styleClass="register-terms"/>

                        <Button text="Daftar Sekarang"
                                onAction="#handleRegister"
                                prefWidth="344.0"
                                prefHeight="44.0"
                                maxWidth="344.0"
                                styleClass="register-button"/>

                        <HBox alignment="CENTER"
                              prefWidth="344.0"
                              spacing="5.0">

                            <children>

                                <Label text="Sudah memiliki akun?"
                                       styleClass="register-text"/>

                                <Hyperlink text="Masuk"
                                           onAction="#handleBackToLogin"
                                           styleClass="register-link"/>

                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </StackPane>

    </children>
</HBox>
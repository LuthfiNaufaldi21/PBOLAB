<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      prefWidth="1200.0"
      prefHeight="720.0"
      styleClass="create-page-root">

    <stylesheets>
        <URL value="@../css/style.css"/>
    </stylesheets>

    <children>

        <!-- SIDEBAR -->
        <VBox minWidth="240.0"
              prefWidth="240.0"
              maxWidth="240.0"
              prefHeight="720.0"
              HBox.hgrow="NEVER"
              spacing="10.0"
              styleClass="sidebar">

            <padding>
                <Insets top="30.0"
                        right="24.0"
                        bottom="24.0"
                        left="24.0"/>
            </padding>

            <children>

                <HBox alignment="CENTER_LEFT"
                      spacing="12.0">

                    <children>

                        <Label text="C"
                               alignment="CENTER"
                               styleClass="sidebar-logo"/>

                        <VBox spacing="1.0">
                            <children>

                                <Label text="CrowdCare"
                                       styleClass="sidebar-title"/>

                                <Label text="Crowdfunding"
                                       styleClass="sidebar-subtitle"/>

                            </children>
                        </VBox>

                    </children>
                </HBox>

                <Region prefHeight="28.0"/>

                <Label text="MENU UTAMA"
                       styleClass="menu-caption"/>

                <Button text="Dashboard"
                        onAction="#openDashboard"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Campaign"
                        onAction="#openCampaigns"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button fx:id="btnCreateCampaign" text="Buat Campaign"
                        onAction="#openCreateCampaign"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button-active"/>

                <Button fx:id="btnDonationHistory" text="Riwayat Donasi"
                        onAction="#openDonationHistory"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Region prefHeight="18.0"/>

                <Label text="AKUN"
                       styleClass="menu-caption"/>

                <Button text="Profil Saya"
                        onAction="#showProfile"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Button text="Pengaturan"
                        onAction="#showSettings"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="nav-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Keluar"
                        onAction="#logout"
                        prefWidth="192.0"
                        prefHeight="44.0"
                        alignment="CENTER_LEFT"
                        styleClass="logout-button"/>

            </children>
        </VBox>

        <!-- KONTEN UTAMA -->
        <VBox prefHeight="720.0"
              HBox.hgrow="ALWAYS"
              styleClass="create-page-main">

            <children>

                <!-- HEADER -->
                <HBox prefHeight="82.0"
                      alignment="CENTER_LEFT"
                      styleClass="dashboard-header">

                    <padding>
                        <Insets top="18.0"
                                right="30.0"
                                bottom="18.0"
                                left="30.0"/>
                    </padding>

                    <children>

                        <VBox spacing="3.0">
                            <children>

                                <Label text="Buat Campaign"
                                       styleClass="dashboard-title"/>

                                <Label text="Lengkapi informasi penggalangan dana yang akan dibuat."
                                       styleClass="dashboard-subtitle"/>

                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="DRAFT"
                               styleClass="draft-status"/>

                    </children>
                </HBox>

                <!-- AREA SCROLL -->
                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            styleClass="dashboard-scroll">

                    <content>

                        <HBox spacing="22.0"
                              alignment="TOP_LEFT"
                              styleClass="create-content">

                            <padding>
                                <Insets top="28.0"
                                        right="30.0"
                                        bottom="35.0"
                                        left="30.0"/>
                            </padding>

                            <children>

                                <!-- FORM -->
                                <VBox spacing="20.0"
                                      HBox.hgrow="ALWAYS"
                                      styleClass="campaign-form-card">

                                    <children>

                                        <VBox spacing="4.0">
                                            <children>

                                                <Label text="Informasi Campaign"
                                                       styleClass="form-section-title"/>

                                                <Label text="Masukkan informasi utama mengenai campaign."
                                                       styleClass="form-section-description"/>

                                            </children>
                                        </VBox>

                                        <Separator/>

                                        <!-- JUDUL -->
                                        <VBox spacing="8.0">
                                            <children>

                                                <Label text="Judul Campaign"
                                                       styleClass="create-input-label"/>

                                                <TextField fx:id="campaignTitleField"
                                                           promptText="Contoh: Bantu Pendidikan Anak Desa"
                                                           prefHeight="44.0"
                                                           styleClass="create-input"/>

                                                <Label text="Gunakan judul yang singkat dan mudah dipahami."
                                                       styleClass="input-helper"/>

                                            </children>
                                        </VBox>

                                        <!-- DESKRIPSI -->
                                        <VBox spacing="8.0">
                                            <children>

                                                <Label text="Deskripsi Campaign"
                                                       styleClass="create-input-label"/>

                                                <TextArea fx:id="campaignDescriptionArea"
                                                          promptText="Ceritakan tujuan campaign dan alasan penggalangan dana..."
                                                          prefHeight="120.0"
                                                          wrapText="true"
                                                          styleClass="create-textarea"/>

                                            </children>
                                        </VBox>

                                        <!-- KATEGORI -->
                                        <VBox spacing="8.0">
                                            <children>

                                                <Label text="Kategori"
                                                       styleClass="create-input-label"/>

                                                <ComboBox fx:id="campaignCategoryBox"
                                                          promptText="Pilih kategori campaign"
                                                          prefHeight="44.0"
                                                          maxWidth="Infinity"
                                                          styleClass="create-combobox"/>

                                            </children>
                                        </VBox>

                                        <!-- TARGET DAN DEADLINE -->
                                        <HBox spacing="16.0">

                                            <children>

                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>

                                                        <Label text="Target Dana"
                                                               styleClass="create-input-label"/>

                                                        <TextField fx:id="campaignTargetField"
                                                                   promptText="Contoh: 10000000"
                                                                   prefHeight="44.0"
                                                                   styleClass="create-input"/>

                                                    </children>
                                                </VBox>

                                                <VBox spacing="8.0"
                                                      HBox.hgrow="ALWAYS">

                                                    <children>

                                                        <Label text="Batas Waktu"
                                                               styleClass="create-input-label"/>

                                                        <DatePicker fx:id="campaignDeadlinePicker"
                                                                    promptText="Pilih tanggal"
                                                                    prefHeight="44.0"
                                                                    maxWidth="Infinity"
                                                                    styleClass="create-date-picker"/>
                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                        <Separator/>

                                        <!-- GAMBAR -->
                                        <VBox spacing="8.0">

                                            <children>

                                                <Label text="Gambar Campaign"
                                                       styleClass="create-input-label"/>

                                                <VBox alignment="CENTER"
                                                      spacing="10.0"
                                                      prefHeight="135.0"
                                                      styleClass="upload-area">

                                                    <children>

                                                        <Label text="＋"
                                                               styleClass="upload-icon"/>

                                                        <Label text="Pilih gambar campaign"
                                                               styleClass="upload-title"/>

                                                        <Label fx:id="uploadDescriptionLabel"
                                                               text="Format JPG atau PNG, maksimal 5 MB"
                                                               styleClass="upload-description"/>

                                                        <Button text="Pilih Gambar"
                                                                onAction="#handleChooseImage"
                                                                styleClass="upload-button"/>

                                                    </children>
                                                </VBox>

                                            </children>
                                        </VBox>

                                        <!-- TOMBOL -->
                                        <HBox alignment="CENTER_RIGHT"
                                              spacing="12.0">

                                            <children>

                                                <Button text="Simpan Draft"
                                                        onAction="#handleSaveDraft"
                                                        prefHeight="42.0"
                                                        styleClass="save-draft-button"/>

                                                <Button text="Ajukan Campaign"
                                                        onAction="#handleSubmitCampaign"
                                                        prefHeight="42.0"
                                                        styleClass="submit-campaign-button"/>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                                <!-- PREVIEW -->
                                <VBox prefWidth="300.0"
                                      spacing="15.0"
                                      styleClass="campaign-preview-section">

                                    <children>

                                        <HBox alignment="CENTER_LEFT">

                                            <children>

                                                <Label text="Preview Campaign"
                                                       styleClass="form-section-title"/>

                                                <Region HBox.hgrow="ALWAYS"/>

                                                <Label text="LIVE"
                                                       styleClass="preview-live-label"/>

                                            </children>
                                        </HBox>

                                        <VBox spacing="12.0"
                                              styleClass="preview-campaign-card">

                                            <children>

                                                <StackPane prefWidth="250.0"
                                                           prefHeight="145.0"
                                                           minHeight="145.0"
                                                           maxHeight="145.0"
                                                           styleClass="preview-image">

                                                    <children>

                                                        <ImageView fx:id="previewImageView"
                                                                   fitWidth="250.0"
                                                                   fitHeight="145.0"
                                                                   preserveRatio="false"
                                                                   smooth="true"
                                                                   visible="false"
                                                                   managed="false"/>

                                                        <Label fx:id="previewImagePlaceholder"
                                                               text="GAMBAR CAMPAIGN"
                                                               styleClass="preview-image-text"/>

                                                    </children>
                                                </StackPane>

                                                <Label fx:id="previewCategoryLabel"
                                                       text="KATEGORI"
                                                       styleClass="preview-category"/>

                                                <Label fx:id="previewTitleLabel"
                                                       text="Judul campaign akan tampil di sini"
                                                       wrapText="true"
                                                       styleClass="preview-title"/>

                                                <Label fx:id="previewDescriptionLabel"
                                                       text="Deskripsi singkat campaign akan tampil di bagian ini."
                                                       wrapText="true"
                                                       styleClass="preview-description"/>

                                                <Separator/>

                                                <Label fx:id="previewAmountLabel"
                                                       text="Rp0 terkumpul"
                                                       styleClass="preview-amount"/>

                                                <ProgressBar progress="0.0"
                                                             prefWidth="250.0"
                                                             styleClass="campaign-progress"/>

                                                <HBox alignment="CENTER_LEFT">

                                                    <children>

                                                        <Label text="0% tercapai"
                                                               styleClass="campaign-percentage"/>

                                                        <Region HBox.hgrow="ALWAYS"/>

                                                        <Label fx:id="previewDeadlineLabel"
                                                               text="Belum ditentukan"
                                                               styleClass="campaign-days"/>

                                                    </children>
                                                </HBox>

                                                <Button text="Donasi Sekarang"
                                                        prefWidth="250.0"
                                                        prefHeight="40.0"
                                                        disable="true"
                                                        styleClass="preview-donate-button"/>

                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0"
                                              styleClass="create-info-box">

                                            <children>

                                                <Label text="Sebelum mengajukan"
                                                       styleClass="info-box-title"/>

                                                <Label text="• Pastikan data campaign sudah benar."
                                                       wrapText="true"
                                                       styleClass="info-box-text"/>

                                                <Label text="• Campaign akan diperiksa oleh admin."
                                                       wrapText="true"
                                                       styleClass="info-box-text"/>

                                                <Label text="• Campaign yang disetujui akan langsung dipublikasikan."
                                                       wrapText="true"
                                                       styleClass="info-box-text"/>

                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </content>
                </ScrollPane>

            </children>
        </VBox>

    </children>
</HBox>